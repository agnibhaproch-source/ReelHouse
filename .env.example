# Data source. Default: the built-in catalogue with original generated artwork (no keys needed).
# Set DATA_SOURCE=tmdb plus a TMDB v4 "API Read Access Token" (server only) for live TMDB data.
DATA_SOURCE=
TMDB_READ_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for POST /api/revalidate
REVALIDATE_SECRET=
# Optional: "Ask Reelhouse" natural-language search uses Claude when set (keyword parser otherwise). Server-only.
ANTHROPIC_API_KEY=
# Optional monitoring
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload (CI/Vercel only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set to 1 to force the built-in catalogue even when DATA_SOURCE=tmdb (tests)
TMDB_FIXTURES=
