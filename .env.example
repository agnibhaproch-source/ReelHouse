# TMDB v4 "API Read Access Token" — server only, never prefix with NEXT_PUBLIC_
TMDB_READ_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for POST /api/revalidate
REVALIDATE_SECRET=
# Optional monitoring
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload (CI/Vercel only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set to 1 to serve offline fixture data instead of TMDB (tests / demos without a token)
TMDB_FIXTURES=
